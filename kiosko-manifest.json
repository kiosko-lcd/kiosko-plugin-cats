                  "en": "Right",
                  "es": "Derecha",
                  "zh-Hant": "右側",
                  "zh-Hans": "右侧"
                },
                "left": {
                  "en": "Left",
                  "es": "Izquierda",
                  "zh-Hant": "左側",
                  "zh-Hans": "左侧"
                },
                "alternate": {
                  "en": "Alternate",
                  "es": "Alternar",
                  "zh-Hant": "交替",
                  "zh-Hans": "交替"
                }
              }
