{
  "manifest": 1,
  "id": "cats",
  "package": "kiosko-plugin-cats",
  "name": {
    "en": "Cats room",
    "es": "Habitación de gatos",
    "zh-Hant": "貓咪房間",
    "zh-Hans": "猫咪房间"
  },
  "version": "0.2.1",
  "description": {
    "en": "Your AI agent sessions as cats in a room: what needs you comes forward. From aimonitor.",
    "es": "Tus sesiones de agentes IA como gatos en una habitación: lo que te reclama se acerca. De aimonitor.",
    "zh-Hant": "把你的 AI 代理工作階段變成房間裡的貓：需要你的會走到前面。來自 aimonitor。",
    "zh-Hans": "把你的 AI 智能体会话变成房间里的猫：需要你的会走到前面。来自 aimonitor。"
  },
  "author": "Kiosko",
  "license": "MIT",
  "homepage": "https://github.com/kiosko-lcd/kiosko-plugin-cats#readme",
  "repository": "https://github.com/kiosko-lcd/kiosko-plugin-cats.git",
  "icon": "cat",
  "sdk": "^0.2.0",
  "platforms": [
    "linux",
    "darwin",
    "win32"
  ],
  "languages": [
    "en",
    "es",
    "zh-Hant",
    "zh-Hans"
  ],
  "categories": [
    "scene"
  ],
  "tags": [
    "agents",
    "claude",
    "gemini",
    "illustration"
  ],
  "permissions": {
    "exec": [
      "git"
    ]
  },
  "riskyOptions": [],
  "requires": [
    {
      "type": "agents/sessions",
      "plugin": "agents"
    }
  ],
  "optional": [
    {
      "type": "weather/current",
      "plugin": "weather"
    }
  ],
  "widgets": [
    {
      "type": "cats/room",
      "name": {
        "en": "Cats room",
        "es": "Habitación de gatos",
        "zh-Hant": "貓咪房間",
        "zh-Hans": "猫咪房间"
      },
      "description": {
        "en": "Each AI agent session is a cat in a room with the real sky outside: the ones that need you come forward, the ones working sit at their laptops in the back.",
        "es": "Cada sesión de un agente IA es un gato en una habitación con el cielo de verdad: los que te necesitan se acercan y los que trabajan se quedan al fondo con su portátil.",
        "zh-Hant": "每個 AI 代理工作階段都是一隻貓，待在窗外是真實天空的房間裡：需要你的貓會走到前面，正在工作的則坐在後面對著筆電。",
        "zh-Hans": "每个 AI 智能体会话都是一只猫，待在窗外是真实天空的房间里：需要你的猫会走到前面，正在工作的则坐在后面对着笔记本电脑。"
      },
      "icon": "cat",
      "category": "scene",
      "tags": [
        "agents",
        "claude",
        "gemini",
        "illustration"
      ],
      "size": {
        "min": {
          "w": 960,
          "h": 300
        },
        "preferred": {
          "w": 1920,
          "h": 462
        }
      },
      "chrome": "bare",
      "sources": [
        "agents/sessions",
        "weather/current"
      ],
      "options": {
        "default": {
          "room": "rotate",
          "rooms": [],
          "projects": [],
          "column": "none",
          "shelf": true,
          "swapSidesMs": 3600000
