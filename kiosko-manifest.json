            "enum": [
              "none",
              "right",
              "left",
              "alternate"
            ]
          },
          "shelf": {
            "title": "Week shelf",
            "description": "A cabinet at the back with a book per commit of yours this week and a binder per merged MR/PR. Read with git in the repos your sessions have been in.",
            "default": true,
            "x-ui": {
              "label": {
                "en": "Week shelf",
                "es": "Estantería de la semana",
                "zh-Hant": "本週書架",
                "zh-Hans": "本周书架"
              },
              "help": {
                "en": "A cabinet at the back with a book per commit of yours this week and a binder per merged MR/PR. Read with git in the repos your sessions have been in.",
                "es": "Un mueble al fondo con un libro por cada commit tuyo de esta semana y un archivador por MR/PR fusionada. Se lee con git en los repos donde han estado tus sesiones.",
                "zh-Hant": "後方的書櫃：本週你的每個提交是一本書，每個已合併的 MR/PR 是一個資料夾。透過 git 讀取你的工作階段待過的儲存庫。",
                "zh-Hans": "后方的书柜：本周你的每个提交是一本书，每个已合并的 MR/PR 是一个文件夹。通过 git 读取你的会话待过的仓库。"
              }
            },
            "type": "boolean"
          },
          "swapSidesMs": {
            "title": "Swap sides every",
            "default": 3600000,
            "x-ui": {
              "label": {
                "en": "Swap sides every",
                "es": "Cambiar de lado cada",
                "zh-Hant": "換邊間隔",
                "zh-Hans": "换边间隔"
              },
              "advanced": true,
              "unit": "ms"
            },
            "type": "integer",
            "minimum": 60000
          }
        }
      },
      "screenshot": "docs/room.png",
      "animated": true,
      "urgent": false
